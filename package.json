{
  "name": "gok-kacisi",
  "version": "1.0.0",
  "private": true,
  "description": "Gök Kaçışı - mobil arcade oyunu (Android / iOS / PWA)",
  "scripts": {
    "serve": "npx http-server www -p 8000 -c-1",
    "sync": "cap sync",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#0b1026' --iconBackgroundColorDark '#0b1026' --splashBackgroundColor '#0b1026' --splashBackgroundColorDark '#0b1026'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
