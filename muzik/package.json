{
  "name": "melodim",
  "version": "1.0.0",
  "private": true,
  "description": "Melodim - reklamsız, arka planda çalan kişisel müzik ve radyo uygulaması",
  "scripts": {
    "serve": "npx http-server www -p 8001 -c-1",
    "sync": "cap sync",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#14111f' --iconBackgroundColorDark '#14111f' --splashBackgroundColor '#14111f' --splashBackgroundColorDark '#14111f'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
